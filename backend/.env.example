# Development email settings. Merge with your existing JWT/database/Redis settings.
NODE_ENV=development
EMAIL_PROVIDER=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM="Nest Shop <no-reply@nest-shop.test>"
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000

# Local SMS inbox (docker compose -f compose.smspit.yml up -d).
SMS_PROVIDER=smspit
SMSPIT_URL=http://127.0.0.1:4300
SMSPIT_PROJECT=default
SMSPIT_API_KEY=
SMS_FROM=NestShop
SMS_TIMEOUT_MS=10000

# Independent local payment provider (development only).
PAYMENT_PROVIDERS=simulated
PAYMENT_SIMULATOR_URL=http://localhost:4400
SHOP_ORIGIN=http://localhost:3000
# Set the same random secret in payment-simulator/.env.
PAYMENT_SIMULATOR_SECRET=

# Optional external server-controlled payment-options JSON.
# PAYMENT_OPTIONS_FILE=/absolute/path/payment-options.json
