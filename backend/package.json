{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "nest build && npm run build:client",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && node dist/main",
    "start:dev": "node scripts/dev.cjs",
    "start:debug": "node scripts/dev.cjs --debug",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:auth": "npm run build && node --test test/auth-authorization.cjs test/auth-flow.e2e.cjs",
    "test:auth:unit": "npm run build && node --test test/auth-authorization.cjs",
    "test:products": "npm run build && node --test test/products-persistence.cjs",
    "test:views": "npm run build && node --test test/views.cjs",
    "test:auth:redis": "npm run build && node --test test/auth-redis.e2e.cjs",
    "test:media": "npm run build && node --test test/product-media.e2e.cjs",
    "test:jobs": "npm run build && node --test test/background-jobs.e2e.cjs",
    "test:email": "npm run build && node --test test/email-delivery.e2e.cjs",
    "test:sms": "npm run build && node --test test/sms-delivery.e2e.cjs",
    "sms:start": "docker compose -f compose.smspit.yml up -d",
    "sms:stop": "docker compose -f compose.smspit.yml stop",
    "test:cart": "npm run build && node --test test/cart.e2e.cjs",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "test:stock": "npm run build && node --test test/products-stock.cjs",
    "products:owners": "node scripts/assign-product-owners.cjs",
    "test:ownership": "npm run build && node --test test/product-ownership.cjs test/product-owner-migration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "@tus/file-store": "^2.1.2",
    "@tus/server": "^2.4.7",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^6.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "hbs": "^4.4.0",
    "mongodb": "^7.8.0",
    "nodemailer": "^10.3.1",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "survey-core": "^3.2.3",
    "survey-js-ui": "^3.2.3",
    "tus-js-client": "^4.3.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/hbs": "^4.0.5",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
