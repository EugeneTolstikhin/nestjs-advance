<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}} | Nest Shop</title>
    <link rel="stylesheet" href="/assets/vendor/survey.css?v=2">
    <link rel="stylesheet" href="/assets/styles.css?v=3">
    <script src="/assets/vendor/survey-core.js" defer></script>
    <script src="/assets/vendor/survey-ui.js" defer></script>
    <script src="/assets/survey-keyboard.js" defer></script>
    <script src="/assets/login.js?v=4" defer></script>
</head>
<body>
    {{> navbar}}
    <main class="auth-page">
        <p class="eyebrow">Your Nest Shop account</p>
        <h1>{{title}}</h1>
        <p class="auth-intro">Use your email and password, or get a one-time code at your verified email or phone number.</p>
        <p id="login-status" class="form-status" role="status" aria-live="polite"></p>
        <div id="login-form" class="auth-card"><p>Loading login form…</p></div>
        <div id="login-code-actions" hidden>
            {{#if smspit}}<p class="dev-notice">Find development SMS codes in <a href="http://localhost:4301" target="_blank" rel="noopener">SMSpit</a>.</p>{{/if}}
            <p class="auth-note">Codes expire after five minutes. A new code replaces the previous one.</p>
            {{#if mailpit}}<p class="dev-notice">Find development email codes in <a href="http://localhost:8025" target="_blank" rel="noopener">Mailpit</a>. LOG codes appear in the server terminal.</p>
            {{else}}{{#if development}}<p class="dev-notice">For LOG delivery, look for your login code in the server terminal.</p>{{/if}}{{/if}}
            <div class="otp-actions">
                <button id="login-resend" type="button" class="nav-button nav-button-secondary">Resend code</button>
                <button id="login-back" type="button" class="nav-button nav-button-secondary">Use another login method</button>
            </div>
        </div>
        <p class="auth-note">New here? <a href="/auth/register">Create an account</a>.</p>
        <noscript><p role="alert">Please enable JavaScript to use this login form.</p></noscript>
    </main>
    {{> footer}}
</body>
</html>
