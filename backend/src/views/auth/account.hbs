<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}} | Nest Shop</title>
    <link rel="stylesheet" href="/assets/vendor/survey.css?v=2">
    <link rel="stylesheet" href="/assets/styles.css?v=4">
    <script src="/assets/vendor/survey-core.js" defer></script>
    <script src="/assets/vendor/survey-ui.js" defer></script>
    <script src="/assets/survey-keyboard.js" defer></script>
    <script src="/assets/account.js?v=2" defer></script>
</head>
<body>
    {{> navbar}}
    <main class="auth-page">
        <p class="eyebrow">One account, both possibilities</p>
        <h1>{{title}}</h1>
        <p class="auth-intro">Buy and sell with the same login. Your verified email and phone stay with this account.</p>
        <p>Enabled roles: {{#each user.roles}}<strong class="account-role">{{this}}</strong> {{/each}}</p>
        <p id="account-status" class="form-status" role="status" aria-live="polite"></p>
        <section class="account-profile" aria-labelledby="buyer-profile-title">
            <h2 id="buyer-profile-title">Buyer profile</h2>
            <p class="auth-note">Enable the buyer role or update your delivery details.</p>
            <div id="buyer-profile-form" class="auth-card account-survey"><p>Loading buyer profile…</p></div>
        </section>
        <section class="account-profile" aria-labelledby="seller-profile-title">
            <h2 id="seller-profile-title">Seller profile</h2>
            <p class="auth-note">Enable the seller role to create and manage products. You can also update your business details here.</p>
            <div id="seller-profile-form" class="auth-card account-survey"><p>Loading seller profile…</p></div>
        </section>
        <noscript><p role="alert">Please enable JavaScript to manage your account profiles.</p></noscript>
    </main>
    {{> footer}}
</body>
</html>
