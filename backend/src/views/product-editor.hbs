<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}} | Nest Shop</title>
    <link rel="stylesheet" href="/assets/vendor/survey.css?v=2">
    <link rel="stylesheet" href="/assets/styles.css?v=6">
    <script src="/assets/vendor/survey-core.js" defer></script>
    <script src="/assets/vendor/survey-ui.js" defer></script>
    <script src="/assets/survey-keyboard.js" defer></script>
    <script src="/assets/vendor/tus.js" defer></script>
    <script src="/assets/media-uploader.js?v=2" defer></script>
    <script src="/assets/product-editor.js?v=3" defer></script>
</head>
<body>
    {{> navbar}}
    <main id="product-page" class="auth-page" data-product-id="{{productId}}">
        <a href="/shop">← Back to products</a>
        <p class="eyebrow">Seller workspace</p>
        <h1>{{title}}</h1>
        <p class="auth-intro">Add photos and videos, arrange their order, then save your product details. Products without uploaded media show a placeholder.</p>
        <p id="product-status" class="form-status" role="status" aria-live="polite"></p>
        <section id="product-media" class="media-uploader" aria-label="Product photos and videos"></section>
        <div id="product-form" class="auth-card product-editor"><p>Loading product form…</p></div>
        <p class="auth-note"><a href="/shop">Cancel and return to products</a></p>
        <noscript><p role="alert">Please enable JavaScript to manage products.</p></noscript>
    </main>
    {{> footer}}
</body>
</html>
