# Email settings only. Configure your actual provider and keep secrets out of Git.
# The application reads .env or process environment variables, not this example file.
NODE_ENV=production
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM="Nest Shop <no-reply@your-domain.example>"
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000

# Use the configured real SMS adapter; SMSpit/LOG are blocked in production.
# A real SMS provider adapter is a separate integration, not an SMSpit endpoint.
SMS_PROVIDER=configured

# Simulator is never enabled in production.
PAYMENT_PROVIDERS=disabled
