{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "src/client",
    "outDir": "dist/public",
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src/client/**/*.ts"]
}
